# Supabase Auth + Storage (la DB ya no está aquí)
# Usa la clave LEGACY "anon" "public" (empieza por eyJ...)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Neon Postgres (Prisma)
# En console.neon.tech → Connection details:
# DATABASE_URL = pooled (incluye -pooler en el host) + ?sslmode=require
# DIRECT_URL   = direct (sin -pooler) + ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# OpenAI (módulo Menús — texto + fallback de fotos)
OPENAI_API_KEY=sk-...

# Opcional: fotos reales de platos vía Pexels (gratis en pexels.com/api)
# Si no está, se usa Openverse (Creative Commons) y luego OpenAI
PEXELS_API_KEY=

# App — producción: https://xx.xacoprol.com
NEXT_PUBLIC_APP_URL=https://xx.xacoprol.com

# Supabase → Authentication → URL Configuration:
# Site URL = https://xx.xacoprol.com
# Redirect URLs =
#   https://xx.xacoprol.com/auth/callback
#   https://xx.xacoprol.com/auth/callback?next=/reset-password
#   https://xx.xacoprol.com/reset-password
#   http://localhost:3000/auth/callback
#   http://localhost:3000/reset-password
