# Supabase
# En el dashboard: Project Settings → API Keys
# Usa la clave LEGACY "anon" "public" (empieza por eyJ...), no solo sb_publishable_
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Prisma — connection string de Supabase (Settings → Database → URI)
# Usa el pooler (Transaction mode, puerto 6543) en producción;
# para migraciones usa la conexión directa (puerto 5432).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# OpenAI (módulo Menús)
OPENAI_API_KEY=sk-...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
